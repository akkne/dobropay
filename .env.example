# Local sandbox values only. Change these for any shared environment.

# Isolated PostgreSQL databases (Database-per-Service)
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=local-auth-db-password
AUTH_DB_NAME=auth_db
AUTH_DB_PORT=5433

MERCHANT_DEV_DB_USER=merchant_dev_user
MERCHANT_DEV_DB_PASSWORD=local-merchant-dev-db-password
MERCHANT_DEV_DB_NAME=merchant_dev_db
MERCHANT_DEV_DB_PORT=5434

PAYMENTS_DB_USER=payments_user
PAYMENTS_DB_PASSWORD=local-payments-db-password
PAYMENTS_DB_NAME=payments_db
PAYMENTS_DB_PORT=5435

NOTIFICATIONS_DB_USER=notifications_user
NOTIFICATIONS_DB_PASSWORD=local-notifications-db-password
NOTIFICATIONS_DB_NAME=notifications_db
NOTIFICATIONS_DB_PORT=5436

RECEIPTS_DB_USER=receipts_user
RECEIPTS_DB_PASSWORD=local-receipts-db-password
RECEIPTS_DB_NAME=receipts_db
RECEIPTS_DB_PORT=5437

# Infrastructure endpoints & ports
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
REDIS_CONNECTION=redis:6379
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=demo@dobropay.local
MAILPIT_HTTP_PORT=8025
GATEWAY_PORT=8080

# Internal service URLs
AUTH_SERVICE_URL=http://auth:8080
DEVELOPER_API_SERVICE_URL=http://developer-api:8080
PAYMENTS_SERVICE_URL=http://payments:8080
NOTIFICATIONS_SERVICE_URL=http://notifications:8080
RECEIPTS_SERVICE_URL=http://receipts:8080
EMAIL_SERVICE_URL=http://email:8080
PUBLIC_BASE_URL=http://localhost:8080

# Secrets
CHECKOUT_SECRET=local-checkout-secret-change-me-32-bytes
PROVIDER_SECRET=local-provider-secret-change-me-32-bytes
WEBHOOK_SECRET=local-webhook-secret-change-me-32-bytes
INTERNAL_SERVICE_KEY=local-internal-service-key-change-me-32-bytes

