{$DOMAIN::8080} {
    handle /v1/auth/* {
        reverse_proxy auth:8080
    }
    handle /v1/developer/* {
        reverse_proxy developer-api:8080
    }
    handle /v1/admin/* {
        reverse_proxy merchant-admin:8080
    }
    handle /v1/payments* {
        reverse_proxy payments:8080
    }
    handle /v1/refunds* {
        reverse_proxy payments:8080
    }
    handle /v1/payment-methods* {
        reverse_proxy payments:8080
    }
    handle /v1/checkout/* {
        reverse_proxy payments:8080
    }
    handle /checkout/*/session {
        reverse_proxy payments:8080
    }
    handle /checkout/*/start {
        reverse_proxy payments:8080
    }
    handle /checkout/*/simulate/* {
        reverse_proxy payments:8080
    }
    handle /v1/provider/* {
        reverse_proxy payments:8080
    }
    handle /v1/receipts* {
        reverse_proxy receipts:8080
    }
    handle /health/live {
        respond "live" 200
    }
    handle /health/ready {
        reverse_proxy payments:8080
    }

    handle {
        reverse_proxy frontend:3000
    }
}

{$WWW_DOMAIN:localhost} {
    redir https://{$DOMAIN}{uri} permanent
}
